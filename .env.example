NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL (Railway'de DATABASE_URL otomatik set edilir)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servis_takip

# Redis (Railway'de REDIS_URL otomatik set edilir)
REDIS_URL=redis://localhost:6379

# JWT — üretimde en az 32 karakter rastgele string kullan
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit (dakika başına istek). Sayaç Redis'te — instance'lar paylaşır.
# Anahtar: kimlikli isteklerde kullanıcı id'si, aksi halde IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOCATION_MAX=12

# ETA motoru — Google Routes API (computeRouteMatrix).
# Anahtar boşsa kuş uçuşu mesafe + ortalama hızla tahmin edilir.
# Gereken API: "Routes API" (legacy Distance Matrix API DEĞİL)
GOOGLE_MAPS_API_KEY=
ETA_FALLBACK_SPEED_KMH=25
# Araç bu yarıçapa (metre) girince durak "geçilmiş" sayılır
ETA_PASSED_RADIUS_METERS=150
# Bu süredir (dakika) ping gelmeyen aktif sefer "abandoned" işaretlenir
TRIP_ABANDON_AFTER_MINUTES=20

# Maliyet kontrolü — Routes API SKU'ları: TRAFFIC_AWARE = Pro (~$10/1K,
# ayda 5.000 ücretsiz), TRAFFIC_UNAWARE = Essentials (~$5/1K, ayda 10.000).
# Bu dakikanın altındaki duraklar trafikli sorulur:
ETA_TRAFFIC_AWARE_MINUTES=15
# Bunun ötesindeki duraklar Google'a hiç sorulmaz:
ETA_GOOGLE_MAX_MINUTES=30
ETA_GOOGLE_MAX_DISTANCE_KM=10
# Günlük element tavanı — aşılırsa haversine'e düşülür + logger.error
GOOGLE_DAILY_ELEMENT_BUDGET=5000
# Google'a tekrar sorma aralığı (saniye): yakında durak varken / yokken
ETA_THROTTLE_NEAR_SECONDS=45
ETA_THROTTLE_FAR_SECONDS=300
# Araç bu kadar (metre) hareket etmediyse önceki sonuç yeniden kullanılır
ETA_MIN_MOVE_METERS=100

# Bildirim kanalları (Faz 4) — boş bırakılan kanal devre dışı kalır
TELEGRAM_BOT_TOKEN=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# Prova modu (Faz F3) — açıkken hiçbir gerçek mesaj gitmez, notification_logs'a
# 'dry_run' olarak düşer. Şirket bazında companies.dry_run ile de açılabilir.
NOTIFICATION_DRY_RUN=false
# Verilirse mesajlar bastırılmak yerine bu tek Telegram hesabına yönlendirilir
NOTIFICATION_TEST_CHAT_ID=
